{
  "name": "delivery-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Laboratorio de entrega: webhook idempotente, retentativa, Docker, CI e observabilidade.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
