{
  "uid": "delivery-lab",
  "title": "Delivery Lab",
  "tags": ["delivery-lab"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API no ar",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "refId": "A", "expr": "up{job=\"delivery-api\"}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "fora", "color": "red" }, "1": { "text": "no ar", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requisicoes por segundo",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, status) (rate(http_requests_total[1m]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Webhooks aceitos e duplicados",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(webhook_events_total[1m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tentativas de entrega",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(delivery_attempts_total[1m]))",
          "legendFormat": "{{result}}"
        }
      ]
    }
  ]
}
